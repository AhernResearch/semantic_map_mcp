{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_frame": {
      "$ref": "#/$defs/frame"
    },
    "bounds_xyz": {
      "$ref": "#/$defs/bbox"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "feature_spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature_space"
      }
    },
    "background_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string"
        },
        "generation": {
          "type": "object"
        },
        "complete": {
          "type": "boolean"
        },
        "source_scene": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene_id": {
              "type": "string"
            },
            "snapshot_id": {
              "type": "string"
            },
            "scene_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "scene_id",
            "snapshot_id",
            "scene_sha256"
          ]
        },
        "source_descriptions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "model",
        "endpoint",
        "generation",
        "complete",
        "source_scene",
        "source_descriptions_sha256"
      ]
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "snapshot_id",
    "name",
    "coordinate_frame",
    "bounds_xyz",
    "types",
    "rooms",
    "objects",
    "observations",
    "assets",
    "feature_spaces",
    "background_asset_id",
    "provenance"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "m"
          ]
        },
        "up_axis": {
          "enum": [
            "y"
          ]
        }
      },
      "required": [
        "frame_id",
        "unit",
        "up_axis"
      ]
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "type_id",
        "name",
        "aliases"
      ]
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "room",
            "corridor",
            "area",
            "unassigned"
          ]
        },
        "bounds_xz": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "polygon_xz": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "boundary_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "room_id",
        "name",
        "kind",
        "bounds_xz",
        "polygon_xz",
        "boundary_source"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "image",
            "pointcloud",
            "feature_matrix"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "path",
        "sha256",
        "kind",
        "metadata"
      ]
    },
    "feature_space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space_id": {
          "type": "string",
          "minLength": 1
        },
        "encoder": {
          "type": "string",
          "minLength": 1
        },
        "weights_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "preprocess_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "dim": {
          "type": "integer",
          "minimum": 1
        },
        "normalized": {
          "type": "boolean"
        },
        "matrix_asset_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "space_id",
        "encoder",
        "weights_fingerprint",
        "preprocess_fingerprint",
        "dim",
        "normalized",
        "matrix_asset_id"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "type_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "room_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "region_assignment_source": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "center_xyz": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "geometry_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "feature_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "space_id": {
                "type": "string",
                "minLength": 1
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "valid": {
                "type": "boolean"
              }
            },
            "required": [
              "space_id",
              "row",
              "valid"
            ]
          }
        },
        "observation_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observation_id": {
                "type": "string",
                "minLength": 1
              },
              "crop_xyxy": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_support": {
                "enum": [
                  "valid",
                  "invalid",
                  "unknown"
                ]
              }
            },
            "required": [
              "observation_id",
              "crop_xyxy",
              "target_support"
            ]
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "source": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "unverified",
                  "reviewed"
                ]
              }
            },
            "required": [
              "key",
              "value",
              "source",
              "verification"
            ]
          }
        },
        "identity_status": {
          "enum": [
            "unresolved",
            "reviewed"
          ]
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_object_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target_object_id",
              "kind",
              "source"
            ]
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description_metadata": {
          "$ref": "#/$defs/description_metadata"
        }
      },
      "required": [
        "object_id",
        "source_id",
        "type_ids",
        "label",
        "aliases",
        "description",
        "room_ids",
        "region_assignment_source",
        "bbox",
        "center_xyz",
        "geometry_asset_id",
        "feature_refs",
        "observation_links",
        "attributes",
        "identity_status",
        "entity_id",
        "source_links",
        "provenance"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "image_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source_kind": {
          "enum": [
            "real_camera",
            "gs_render"
          ]
        },
        "reconstruction_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "rendered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "K": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "camera_to_world": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "camera_convention": {
          "enum": [
            "opencv_xright_ydown_zforward",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "observation_id",
        "image_asset_id",
        "width",
        "height",
        "source_kind",
        "reconstruction_id",
        "captured_at",
        "rendered_at",
        "K",
        "camera_to_world",
        "camera_convention",
        "provenance"
      ]
    },
    "description_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description_id",
        "status",
        "sources",
        "provenance",
        "error",
        "original_description"
      ],
      "properties": {
        "description_id": {
          "type": "string",
          "pattern": "^desc-[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "ok",
            "unclear",
            "unavailable",
            "error"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observation_id",
              "image_asset_id",
              "image_sha256",
              "crop_xyxy",
              "target_support",
              "source_kind",
              "source_refs"
            ]
          }
        },
        "provenance": {
          "type": "object"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "title": "MapQueryTools Scene Package 1.0.0"
}
